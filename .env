# Nextcloud Configuration
NEXTCLOUD_URL=https://deine-nextcloud.de/remote.php/dav/files/DEIN_USERNAME/
NEXTCLOUD_USER=DEIN_USERNAME
NEXTCLOUD_PASSWORD=DEIN_APP_PASSWORT
NEXTCLOUD_FOLDER=YouTube_Playlists

# YouTube Configuration (kommagetrennt für mehrere Playlists)
PLAYLIST_URLS=https://www.youtube.com/playlist?list=PLAYLIST_ID_1,https://www.youtube.com/playlist?list=PLAYLIST_ID_2

# Download Options (true for mp3, false for mp4)
AUDIO_ONLY=true